{
  "name": "ava-addon-hello",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": "Sami Fouad",
  "type": "module",
  "description": "Hello: the smallest real Ava add-on, written to be read. `npm run build` writes the add-on's bundle to dist/. Its version is public/manifest.json's, nowhere else.",
  "repository": "https://github.com/avacanada/ava-addon-hello",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@modelcontextprotocol/ext-apps": "2.1.0"
  },
  "devDependencies": {
    "@addiscorp/ava-addon": "0.1.0",
    "@types/node": "26.6.6",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
